# AI Finance Controller - Environment Configuration
# Copy this file to .env and fill in your actual values

# Groq API Key (required for LLM reasoning)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider (groq or ollama)
# Use "groq" for the free cloud API (requires GROQ_API_KEY)
# Use "ollama" for local inference (requires Ollama running locally)
LLM_PROVIDER=groq
